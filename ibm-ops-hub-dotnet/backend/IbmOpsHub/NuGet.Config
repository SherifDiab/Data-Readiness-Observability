<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet.Config - Corporate Firewall / Offline Configuration
  ==========================================================

  If nuget.org is BLOCKED by your corporate firewall, choose one of the
  options below and uncomment the relevant section.

  OPTION A: Corporate NuGet proxy / internal feed (Nexus, Artifactory, Azure Artifacts)
  ----------------------------------------------------------------------------------------
  Replace the URL below with your organisation's internal NuGet feed URL.
  Ask your infrastructure/DevOps team for the correct URL.

  OPTION B: Local folder feed (fully offline)
  -------------------------------------------
  1. On a machine WITH internet, run: .\deploy\build-local.ps1  (see that script)
  2. Copy the produced "artifacts\" folder to the server.
  3. Uncomment the <add> under "OPTION B" and point the path at that folder.

  OPTION C: HTTP proxy pass-through
  -----------------------------------
  Set the HTTPS_PROXY environment variable before running dotnet restore:
    $env:HTTPS_PROXY = "http://your-proxy-server:port"
  No changes to this file needed.
-->
<configuration>

  <packageSources>
    <clear />

    <!-- ===== OPTION A: Internal / proxy NuGet feed ===== -->
    <!-- Uncomment and set the correct URL for your corporate feed -->
    <!--
    <add key="Corporate NuGet" value="https://nexus.your-company.com/repository/nuget-proxy/index.json" />
    -->

    <!-- ===== OPTION B: Local folder feed (offline) ===== -->
    <!-- Uncomment and set the path to your local packages folder -->
    <!--
    <add key="Local Packages" value="C:\nuget-packages" />
    -->

    <!-- ===== Default (internet required) ===== -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />

  </packageSources>

  <packageSourceCredentials>
    <!-- If your internal feed requires authentication, add credentials here -->
    <!--
    <Corporate_NuGet>
      <add key="Username" value="your-username" />
      <add key="ClearTextPassword" value="your-password" />
    </Corporate_NuGet>
    -->
  </packageSourceCredentials>

</configuration>
