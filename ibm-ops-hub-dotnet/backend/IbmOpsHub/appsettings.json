{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=opshub;Username=postgres;Password=postgres",
    "Redis": "localhost:6379"
  },
  "AppSettings": {
    "CpdBaseUrl": "",
    "CpdUsername": "",
    "CpdPassword": "",
    "CpdProjectId": "default-project",
    "CpdProjectIds": "",
    "DatastageUseCpd": true,
    "IisBaseUrl": "",
    "IisUsername": "",
    "IisPassword": "",
    "K8sInCluster": false,
    "K8sKubeconfig": "",
    "K8sNamespace": "event-automation",
    "FlinkCrdGroup": "flink.apache.org",
    "FlinkCrdVersion": "v1beta1",
    "FlinkRestUrl": "",
    "FlinkClusters": "",
    "ApicMgmtUrl": "",
    "ApicAnalyticsUrl": "",
    "ApicOrg": "",
    "ApicCatalog": "",
    "ApicUsername": "",
    "ApicPassword": "",
    "ApicRealm": "provider/default-idp-2",
    "SparkPollInterval": 30,
    "DatastagePollInterval": 30,
    "FlinkPollInterval": 15,
    "EventProcessingPollInterval": 30,
    "ApicPollInterval": 60,
    "MockMode": false,
    "MockServerUrl": "http://localhost:9000",
    "EnableAlerting": false,
    "SlackWebhookUrl": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/ibm-ops-hub-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
