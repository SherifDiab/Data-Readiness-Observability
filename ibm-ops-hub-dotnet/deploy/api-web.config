<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS web.config for the ASP.NET Core backend.
  Uses the AspNetCoreModuleV2 (included in the .NET Hosting Bundle).
  The Kestrel process is managed by IIS as a reverse proxy.
-->
<configuration>
  <system.webServer>

    <handlers>
      <add name="aspNetCore" path="*" verb="*"
           modules="AspNetCoreModuleV2"
           resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath="dotnet"
                arguments=".\IbmOpsHub.dll"
                stdoutLogEnabled="true"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        <!-- Override connection strings here if needed, or edit appsettings.json -->
        <!--
        <environmentVariable name="ConnectionStrings__DefaultConnection"
                             value="Host=localhost;Database=opshub;Username=postgres;Password=YOUR_PASSWORD" />
        <environmentVariable name="ConnectionStrings__Redis" value="localhost:6379" />
        -->
      </environmentVariables>
    </aspNetCore>

  </system.webServer>
</configuration>
