# ============================================================
# IBM Ops Hub — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Cloud Pak for Data (Spark + DataStage) ---
CPD_BASE_URL=https://cpd-instance.example.com
CPD_USERNAME=admin
CPD_PASSWORD=changeme
CPD_PROJECT_ID=your-project-id

# --- DataStage (IIS mode, only if DATASTAGE_USE_CPD=False) ---
DATASTAGE_USE_CPD=True
IIS_BASE_URL=
IIS_USERNAME=
IIS_PASSWORD=

# --- Kubernetes (Event Processing FlinkDeployments) ---
K8S_IN_CLUSTER=True
K8S_KUBECONFIG=
K8S_NAMESPACE=event-automation
FLINK_CRD_GROUP=flink.apache.org
FLINK_CRD_VERSION=v1beta1

# --- Flink REST API ---
FLINK_REST_URL=http://flink-jobmanager:8081
FLINK_CLUSTERS=

# --- API Connect ---
APIC_MGMT_URL=https://apic-mgmt.example.com
APIC_ANALYTICS_URL=https://apic-analytics.example.com
APIC_ORG=myorg
APIC_CATALOG=sandbox
APIC_USERNAME=admin
APIC_PASSWORD=changeme
APIC_REALM=provider/default-idp-2

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/opshub

# --- Polling Intervals (seconds) ---
SPARK_POLL_INTERVAL=30
DATASTAGE_POLL_INTERVAL=30
FLINK_POLL_INTERVAL=15
EVENT_PROCESSING_POLL_INTERVAL=30
APIC_POLL_INTERVAL=60

# --- Feature Flags ---
MOCK_MODE=False
MOCK_SERVER_URL=http://mock-server:9000
ENABLE_ALERTING=False
SLACK_WEBHOOK_URL=
